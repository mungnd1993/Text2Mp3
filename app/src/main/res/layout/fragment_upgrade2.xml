<!--                      </androidx.constraintlayout.widget.ConstraintLayout>-->

                      <androidx.constraintlayout.widget.ConstraintLayout
                          android:id="@+id/cl_week"
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:paddingVertical="12dp"
                          android:paddingHorizontal="20dp"
                          android:background="@drawable/bg_upgrade_active">

                          <androidx.appcompat.widget.AppCompatTextView
                              android:id="@+id/tv_heading1"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toTopOf="parent"
                              app:layout_constraintStart_toStartOf="parent"
                              android:text="@string/three_days_free_trial_auto_renewal"
                              android:textSize="12sp"
                              android:textColor="#6E727D"
                              android:fontFamily="@font/roboto_medium"/>

                          <androidx.constraintlayout.widget.ConstraintLayout
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toBottomOf="@+id/tv_heading1"
                              app:layout_constraintStart_toStartOf="parent"
                              android:layout_marginTop="2dp">

                              <androidx.appcompat.widget.AppCompatTextView
                                  android:id="@+id/tv_price1"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  app:layout_constraintTop_toTopOf="parent"
                                  app:layout_constraintStart_toStartOf="parent"
                                  app:layout_constraintBottom_toBottomOf="parent"
                                  android:textColor="@color/black"
                                  android:textSize="16sp"
                                  android:fontFamily="@font/roboto_bold"/>

                              <androidx.appcompat.widget.AppCompatTextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  app:layout_constraintStart_toEndOf="@id/tv_price1"
                                  app:layout_constraintBottom_toBottomOf="parent"
                                  android:layout_marginBottom="1dp"
                                  android:text="@string/cancel_anytime"
                                  android:textColor="#6E727D"
                                  android:textSize="12sp"
                                  android:fontFamily="@font/roboto_medium"/>

                          </androidx.constraintlayout.widget.ConstraintLayout>

                      </androidx.constraintlayout.widget.ConstraintLayout>

                      <androidx.constraintlayout.widget.ConstraintLayout
                          android:id="@+id/cl_annual"
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:layout_marginTop="12dp"
                          android:paddingVertical="12dp"
                          android:paddingHorizontal="20dp"
                          android:background="@drawable/bg_upgrade_unactive">

                          <androidx.constraintlayout.widget.ConstraintLayout
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toTopOf="parent"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintEnd_toEndOf="parent"
                              android:paddingHorizontal="12dp"
                              android:paddingVertical="6dp"
                              android:visibility="invisible"
                              android:background="@drawable/bg_upgrade_discount">

                              <androidx.appcompat.widget.AppCompatTextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  app:layout_constraintTop_toTopOf="parent"
                                  app:layout_constraintStart_toStartOf="parent"
                                  app:layout_constraintEnd_toEndOf="parent"
                                  app:layout_constraintBottom_toBottomOf="parent"
                                  android:text="@string/save_30"
                                  android:textSize="10sp"
                                  android:textColor="@color/white"
                                  android:fontFamily="@font/roboto_bold"
                                  tools:ignore="SmallSp" />

                          </androidx.constraintlayout.widget.ConstraintLayout>

                          <androidx.appcompat.widget.AppCompatTextView
                              android:id="@+id/tv_heading2"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toTopOf="parent"
                              app:layout_constraintStart_toStartOf="parent"
                              android:text="@string/three_days_free_trial_auto_renewal"
                              android:textSize="12sp"
                              android:textColor="#6E727D"
                              android:fontFamily="@font/roboto_medium"/>

                          <androidx.constraintlayout.widget.ConstraintLayout
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toBottomOf="@+id/tv_heading2"
                              app:layout_constraintStart_toStartOf="parent"
                              android:layout_marginTop="2dp">

                              <androidx.appcompat.widget.AppCompatTextView
                                  android:id="@+id/tv_price2"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  app:layout_constraintTop_toTopOf="parent"
                                  app:layout_constraintStart_toStartOf="parent"
                                  app:layout_constraintBottom_toBottomOf="parent"
                                  android:textColor="@color/black"
                                  android:textSize="16sp"
                                  android:fontFamily="@font/roboto_bold"/>

                              <androidx.appcompat.widget.AppCompatTextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  app:layout_constraintStart_toEndOf="@id/tv_price2"
                                  app:layout_constraintBottom_toBottomOf="parent"
                                  android:layout_marginBottom="1dp"
                                  android:text="@string/cancel_anytime"
                                  android:textColor="#6E727D"
                                  android:textSize="12sp"
                                  android:fontFamily="@font/roboto_medium"/>

                          </androidx.constraintlayout.widget.ConstraintLayout>

                      </androidx.constraintlayout.widget.ConstraintLayout>

                  </androidx.appcompat.widget.LinearLayoutCompat>

                  <androidx.constraintlayout.widget.ConstraintLayout
                      android:id="@+id/cl_secured"
                      android:layout_width="155dp"
                      android:layout_height="23dp"
                      android:layout_marginTop="20dp"
                      app:layout_constraintTop_toBottomOf="@+id/ll_select"
                      app:layout_constraintEnd_toEndOf="parent"
                      app:layout_constraintStart_toStartOf="parent">

                      <androidx.appcompat.widget.AppCompatImageView
                          android:id="@+id/iv_shield"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:src="@drawable/ic_shield"
                          app:layout_constraintBottom_toBottomOf="parent"
                          app:layout_constraintStart_toStartOf="parent"
                          app:layout_constraintTop_toTopOf="parent" />

                      <androidx.appcompat.widget.AppCompatTextView
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:layout_marginStart="6dp"
                          android:fontFamily="@font/roboto_regular"
                          android:text="@string/secured_with_app_store"
                          android:textColor="@color/grey_text"
                          android:textSize="12sp"
                          app:layout_constraintBottom_toBottomOf="parent"
                          app:layout_constraintStart_toEndOf="@+id/iv_shield"
                          app:layout_constraintTop_toTopOf="parent" />

                  </androidx.constraintlayout.widget.ConstraintLayout>

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/bt_continue"
                      android:layout_width="match_parent"
                      android:layout_height="64dp"
                      app:layout_constraintTop_toBottomOf="@+id/cl_secured"
                      app:layout_constraintStart_toStartOf="parent"
                      app:layout_constraintEnd_toEndOf="parent"
                      android:layout_marginTop="8dp"
                      android:layout_marginHorizontal="20dp"
                      android:text="@string/try_for_free"
                      android:textColor="#F5F5F5"
                      android:backgroundTint="@color/blue_bold"
                      app:cornerRadius="16dp"
                      android:textAllCaps="false"
                      android:fontFamily="@font/roboto_medium"/>

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/bt_ads"
                      android:layout_width="match_parent"
                      android:layout_height="64dp"
                      app:layout_constraintTop_toBottomOf="@+id/bt_continue"
                      app:layout_constraintStart_toStartOf="parent"
                      app:layout_constraintEnd_toEndOf="parent"
                      android:layout_marginTop="8dp"
                      android:layout_marginHorizontal="20dp"
                      android:text="@string/continue_with_ads"
                      android:textColor="@color/blue_bold"
                      android:backgroundTint="@color/white"
                      app:strokeColor="@color/blue_bold"
                      app:strokeWidth="1dp"
                      app:cornerRadius="16dp"
                      android:textAllCaps="false"
                      android:fontFamily="@font/roboto_medium"/>

                  <androidx.constraintlayout.widget.ConstraintLayout
                      android:id="@+id/cl_policy"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      app:layout_constraintTop_toBottomOf="@id/bt_ads"
                      app:layout_constraintStart_toStartOf="parent"
                      app:layout_constraintEnd_toEndOf="parent"
                      android:layout_marginTop="8dp">

                      <androidx.appcompat.widget.AppCompatTextView
                          android:id="@+id/tv_policy"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          app:layout_constraintTop_toTopOf="parent"
                          app:layout_constraintBottom_toBottomOf="parent"
                          app:layout_constraintStart_toStartOf="parent"
                          android:text="@string/policy"
                          android:textSize="12sp"
                          android:textColor="#515152"
                          android:fontFamily="@font/roboto_regular" />

                      <androidx.appcompat.widget.AppCompatTextView
                          android:id="@+id/tv_and"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          app:layout_constraintTop_toTopOf="parent"
                          app:layout_constraintBottom_toBottomOf="parent"
                          app:layout_constraintStart_toEndOf="@id/tv_policy"
                          android:layout_marginStart="2dp"
                          android:text="@string/and_symbol"
                          android:textSize="12sp"
                          android:textColor="#515152"
                          android:fontFamily="@font/roboto_regular"/>

                      <androidx.appcompat.widget.AppCompatTextView
                          android:id="@+id/tv_term"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          app:layout_constraintTop_toTopOf="parent"
                          app:layout_constraintBottom_toBottomOf="parent"
                          app:layout_constraintStart_toEndOf="@id/tv_and"
                          android:layout_marginStart="2dp"
                          android:text="@string/terms_of_use"
                          android:textSize="12sp"
                          android:textColor="#515152"
                          android:fontFamily="@font/roboto_regular"/>

                  </androidx.constraintlayout.widget.ConstraintLayout>

              </androidx.constraintlayout.widget.ConstraintLayout>

          </ScrollView>

