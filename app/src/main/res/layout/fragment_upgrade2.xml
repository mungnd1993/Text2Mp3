<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.fragments.Upgrade2Fragment">

       <androidx.constraintlayout.widget.ConstraintLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content">

           <androidx.appcompat.widget.AppCompatImageView
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:src="@drawable/bg_upgrade"
               app:layout_constraintTop_toTopOf="parent"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintEnd_toEndOf="parent"
               android:scaleType="fitStart" />

          <ScrollView
              android:layout_width="match_parent"
              android:layout_height="0dp"
              app:layout_constraintTop_toTopOf="parent"
              android:scrollbars="none">

              <androidx.constraintlayout.widget.ConstraintLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:paddingBottom="24dp">

                  <androidx.appcompat.widget.AppCompatImageView
                      android:id="@+id/iv_diamond"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      app:layout_constraintTop_toTopOf="parent"
                      app:layout_constraintStart_toStartOf="parent"
                      app:layout_constraintEnd_toEndOf="parent"
                      android:src="@drawable/ic_diamond"
                      android:layout_marginTop="100dp"/>

                  <androidx.appcompat.widget.AppCompatTextView
                      android:id="@+id/tv_title"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      app:layout_constraintTop_toBottomOf="@+id/iv_diamond"
                      app:layout_constraintStart_toStartOf="parent"
                      app:layout_constraintEnd_toEndOf="parent"
                      android:layout_marginTop="24dp"
                      android:text="@string/text_to_speech_pro"
                      android:textColor="@color/black"
                      android:textSize="24sp"
                      android:fontFamily="@font/roboto_semibold"/>

                  <androidx.appcompat.widget.AppCompatTextView
                      android:id="@+id/tv_subtitle"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      app:layout_constraintTop_toBottomOf="@+id/tv_title"
                      app:layout_constraintStart_toStartOf="parent"
                      app:layout_constraintEnd_toEndOf="parent"
                      android:layout_marginTop="6dp"
                      android:text="@string/read_anything_aloud_in_top_quality_voices"
                      android:textSize="14sp"
                      android:textColor="@color/grey_text"
                      android:fontFamily="@font/roboto_regular"/>

                  <androidx.constraintlayout.widget.ConstraintLayout
                      android:id="@+id/cl_features"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
                      app:layout_constraintStart_toStartOf="parent"
                      app:layout_constraintEnd_toEndOf="parent"
                      android:layout_marginHorizontal="20dp"
                      android:layout_marginTop="26dp">

                      <androidx.constraintlayout.widget.ConstraintLayout
                          android:id="@+id/cl_one"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          app:layout_constraintTop_toTopOf="parent"
                          app:layout_constraintStart_toStartOf="parent">

                          <androidx.appcompat.widget.AppCompatImageView
                              android:id="@+id/iv_voice"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toTopOf="parent"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintStart_toStartOf="parent"
                              android:src="@drawable/ic_voice_square"/>

                          <androidx.constraintlayout.widget.ConstraintLayout
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toTopOf="parent"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintStart_toEndOf="@+id/iv_voice"
                              android:layout_marginStart="20dp">

                              <androidx.appcompat.widget.AppCompatTextView
                                  android:id="@+id/tv_support"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  app:layout_constraintTop_toTopOf="parent"
                                  app:layout_constraintStart_toStartOf="parent"
                                  android:text="@string/more_than_100_languages"
                                  android:textColor="@color/black"
                                  android:textSize="14sp"
                                  android:fontFamily="@font/roboto_medium"/>

                          </androidx.constraintlayout.widget.ConstraintLayout>

                      </androidx.constraintlayout.widget.ConstraintLayout>

                      <androidx.constraintlayout.widget.ConstraintLayout
                          android:id="@+id/cl_two"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          app:layout_constraintTop_toBottomOf="@id/cl_one"
                          app:layout_constraintStart_toStartOf="parent"
                          android:layout_marginTop="15dp">

                          <androidx.appcompat.widget.AppCompatImageView
                              android:id="@+id/iv_remove_ads"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toTopOf="parent"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintStart_toStartOf="parent"
                              android:src="@drawable/ic_remove_ads"/>

                          <androidx.constraintlayout.widget.ConstraintLayout
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toTopOf="parent"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintStart_toEndOf="@+id/iv_remove_ads"
                              android:layout_marginStart="20dp">

                              <androidx.appcompat.widget.AppCompatTextView
                                  android:id="@+id/tv_remove_ads"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  app:layout_constraintTop_toTopOf="parent"
                                  app:layout_constraintStart_toStartOf="parent"
                                  android:text="@string/remove_ads"
                                  android:textColor="@color/black"
                                  android:textSize="14sp"
                                  android:fontFamily="@font/roboto_medium"/>

                          </androidx.constraintlayout.widget.ConstraintLayout>

                      </androidx.constraintlayout.widget.ConstraintLayout>

                      <androidx.constraintlayout.widget.ConstraintLayout
                          android:id="@+id/cl_three"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          app:layout_constraintTop_toBottomOf="@id/cl_two"
                          app:layout_constraintStart_toStartOf="parent"
                          android:layout_marginTop="15dp">

                          <androidx.appcompat.widget.AppCompatImageView
                              android:id="@+id/iv_download"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toTopOf="parent"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintStart_toStartOf="parent"
                              android:src="@drawable/ic_download_blue"/>

                          <androidx.constraintlayout.widget.ConstraintLayout
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              app:layout_constraintTop_toTopOf="parent"
                              app:layout_constraintBottom_toBottomOf="parent"
                              app:layout_constraintStart_toEndOf="@+id/iv_download"
                              android:layout_marginStart="20dp">

                              <androidx.appcompat.widget.AppCompatTextView
                                  android:id="@+id/tv_download"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  app:layout_constraintTop_toTopOf="parent"
                                  app:layout_constraintStart_toStartOf="parent"
                                  android:text="@string/load_audio_file"
                                  android:textColor="@color/black"
                                  android:textSize="14sp"
                                  android:fontFamily="@font/roboto_medium"/>

                          </androidx.constraintlayout.widget.ConstraintLayout>

                      </androidx.constraintlayout.widget.ConstraintLayout>



                  </androidx.constraintlayout.widget.ConstraintLayout>

                  <androidx.appcompat.widget.LinearLayoutCompat
                      android:id="@+id/ll_select"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      app:layout_constraintTop_toBottomOf="@+id/cl_features"
                      app:layout_constraintStart_toStartOf="parent"
                      app:layout_constraintEnd_toEndOf="parent"
                      android:layout_marginHorizontal="20dp"
                      android:layout_marginTop="32dp"
                      android:orientation="vertical">

<!--                      <androidx.constraintlayout.widget.ConstraintLayout-->
<!--                          android:id="@+id/cl_try"-->
<!--                          android:layout_width="match_parent"-->
<!--                          android:layout_height="wrap_content"-->
